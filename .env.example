# Waguri Persona-Twin Environment Template
# Copy this file to .env and insert your real credentials. NEVER commit .env!

PORT=8080
PUBLIC_BASE_URL=

# --- Storage (Supabase Postgres + pgvector) ---
# Use 'supabase' in production, or 'memory' for local dev without a database
STORAGE_ADAPTER=supabase
DATABASE_URL=postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# --- Secrets ---
# 64 hex chars = 32 bytes AES-256-GCM key to encrypt provider keys at rest
APP_ENCRYPTION_KEY=
# Token for admin routes (/api/reset-quotas, /api/keypool/status)
ADMIN_TOKEN=

# --- CORS ---
CORS_ORIGINS=*

# --- LLM Provider Tiers (failover order: groq, nvidia, google, openrouter, minimax) ---
LLM_PROVIDER_TIERS=groq,nvidia,google,openrouter

# --- Groq (Tier 1) ---
LLM_MODELS_GROQ=openai/gpt-oss-20b,openai/gpt-oss-120b,qwen/qwen3.8-27b
GROQ_DAILY_QUOTA=1000
GROQ_API_KEY_1=
GROQ_API_KEY_2=

# --- NVIDIA NIM (Tier 2) ---
LLM_MODELS_NVIDIA=meta/llama-3.2-11b-vision-instruct
NVIDIA_DAILY_QUOTA=40
NVIDIA_API_KEY_1=

# --- Google Gemini (Tier 3) ---
LLM_MODELS_GOOGLE=gemini-3.6-flash
GOOGLE_DAILY_QUOTA=1500
GOOGLE_API_KEY_1=

# --- OpenRouter (Tier 4) ---
LLM_MODELS_OPENROUTER=nvidia/nemotron-3.5-lightning:free,z-ai/glm-5.2:free,google/gemma-4-31b-it:free
OPENROUTER_DAILY_QUOTA=50
OPENROUTER_API_KEY_1=

# --- Embeddings (RAG Memory) ---
EMBEDDINGS_PROVIDER=openai-compat
EMBEDDINGS_BASE_URL=https://api.jina.ai/v1
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=jina-embeddings-v3
EMBEDDINGS_DIM=1024

# --- RAG ---
RAG_TOP_K=6
RAG_RECENT_MESSAGES=10

# --- TTS ---
TTS_PROVIDERS=edge,azure,google
TTS_VOICE=en-IN-NeerjaNeural
TTS_VOICE_HINDI=hi-IN-SwaraNeural
