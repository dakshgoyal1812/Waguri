# Waguri Persona-Twin Environment Template
# Copy this file to .env and insert your real credentials. NEVER commit .env!

PORT=8080
PUBLIC_BASE_URL=

# --- Storage (Supabase Postgres + pgvector) ---
# Use 'supabase' in production, or 'memory' for local dev without a database
STORAGE_ADAPTER=supabase
DATABASE_URL=postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Backend-only values (NEVER exposed to the frontend):
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Frontend-safe values (the ONLY Supabase vars the Vite build may see):
VITE_SUPABASE_URL=https://<ref>.supabase.co
VITE_SUPABASE_ANON_KEY=

# --- Secrets ---
# 64 hex chars = 32 bytes AES-256-GCM key to encrypt provider keys at rest
APP_ENCRYPTION_KEY=
# Token for cron/maintenance admin routes (/api/reset-quotas, /api/keypool/status, /api/push/trigger-auto).
# Server-side only — NEVER ship to the frontend. Rotate if it ever leaked.
ADMIN_TOKEN=
# Verified admin identities: the Supabase JWT email must match one of these (comma-separated).
ADMIN_EMAILS=
# Memory Vault passcode for /api/memory — checked SERVER-SIDE only (never in the frontend bundle).
MEMORY_VAULT_PASSWORD=

# --- CORS ---
CORS_ORIGINS=*

# --- LLM Provider Tiers (failover order: groq, nvidia, google, openrouter, minimax) ---
LLM_PROVIDER_TIERS=google,groq,nvidia,openrouter,minimax

# --- Groq (Tier 2) ---
LLM_MODELS_GROQ=qwen/qwen3.8-27b,groq/compound-mini,openai/gpt-oss-120b
GROQ_DAILY_QUOTA=1000
GROQ_API_KEY_1=
GROQ_API_KEY_2=

# --- NVIDIA NIM (Tier 3) ---
LLM_MODELS_NVIDIA=meta/llama-3.2-11b-vision-instruct
NVIDIA_DAILY_QUOTA=40
NVIDIA_API_KEY_1=

# --- Google Gemini (Tier 1) ---
LLM_MODELS_GOOGLE=gemini-3.5-flash-lite,gemini-3.6-flash,gemini-3.5-flash
GOOGLE_DAILY_QUOTA=1500
GOOGLE_API_KEY_1=

# --- OpenRouter (Tier 4) ---
LLM_MODELS_OPENROUTER=openrouter/free,openai/gpt-oss-120b,openai/gpt-oss-20b
OPENROUTER_DAILY_QUOTA=50
OPENROUTER_API_KEY_1=

# --- Embeddings (RAG Memory) ---
EMBEDDINGS_PROVIDER=openai-compat
EMBEDDINGS_BASE_URL=https://api.jina.ai/v1
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=jina-embeddings-v3
EMBEDDINGS_DIM=1024

# --- RAG ---
RAG_TOP_K=6
RAG_RECENT_MESSAGES=10

# --- TTS ---
TTS_PROVIDERS=edge,azure,fishaudio,gemini,google
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Leda
GEMINI_TTS_STYLE=A soothing female voice with a gentle, empathetic tone. This voice is characterized by a fast, measured pace that creates an intimate and calming atmosphere.
TTS_VOICE=en-IN-NeerjaNeural
TTS_VOICE_HINDI=hi-IN-SwaraNeural

# --- Web Push Notifications (PWA) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Firebase service-account private key JSON (raw or base64) for native Android (APK) push delivery.
# Create a Firebase project, generate a service account key, paste its JSON here.
FCM_SERVICE_ACCOUNT_JSON=
VAPID_SUBJECT=mailto:your-email@example.com
