# Waguri backend — environment variables (Render service, PRD section 11)
# Copy real values into the Render dashboard; never commit them.

PORT=8080
# PUBLIC_BASE_URL=https://waguri-backend.onrender.com

# --- Database (Supabase) ---
STORAGE_ADAPTER=supabase
DATABASE_URL=postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# --- Secrets ---
# 64 hex chars = 32 bytes for AES-256-GCM key encryption (api_keys.key_value)
APP_ENCRYPTION_KEY=
# Protects POST /api/reset-quotas and GET /api/keypool/status
ADMIN_TOKEN=

# --- CORS ---
CORS_ORIGINS=https://your-frontend.vercel.app

# --- LLM tiers, in failover order (PRD section 9.2: openrouter primary, groq/nvidia second) ---
LLM_PROVIDER_TIERS=openrouter,groq
# Models stay config, never hardcoded (PRD section 13)
LLM_MODELS_OPENROUTER=meta-llama/llama-3.3-70b-instruct:free,google/gemini-2.0-flash-exp:free,deepseek/deepseek-chat-v3-0324:free
LLM_MODELS_GROQ=llama-3.3-70b-versatile
# Optional base URL overrides (tests / self-hosted OpenAI-compatible servers)
# LLM_BASE_URL_OPENROUTER=http://127.0.0.1:9090/v1

# --- Keys (seeded into api_keys on first boot, then encrypted at rest) ---
OPENROUTER_API_KEYS=sk-or-v1-xxx,sk-or-v1-yyy,sk-or-v1-zzz
OPENROUTER_DAILY_QUOTA=50
GROQ_API_KEYS=gsk_xxx
GROQ_DAILY_QUOTA=1000

# --- Embeddings (PRD section 6: Jina / Cohere / OpenAI-compatible) ---
EMBEDDINGS_PROVIDER=openai-compat
EMBEDDINGS_BASE_URL=https://api.jina.ai/v1
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=jina-embeddings-v3
EMBEDDINGS_DIM=1024
# Local/test fallback: EMBEDDINGS_PROVIDER=hash-test EMBEDDINGS_DIM=384

# --- RAG (PRD section 8: top 5-8 chunks, last N messages) ---
RAG_TOP_K=6
RAG_RECENT_MESSAGES=10

# --- TTS (PRD sections 6 + 9.4) ---
TTS_PROVIDERS=edge,azure,google
TTS_VOICE=en-IN-NeerjaNeural
# Hindi voice for Devanagari replies (bilingual EN + Hinglish/Hindi output)
TTS_VOICE_HINDI=hi-IN-SwaraNeural
# Azure keys seeded as region:key pairs; region rides on api_keys.account_label
AZURE_TTS_KEYS=eastus:your-azure-key
AZURE_TTS_DAILY_QUOTA=500
# Optional Fish Audio (native API; OpenRouter has no TTS endpoint)
# FISH_AUDIO_BASE_URL=https://api.fish.audio
# FISH_AUDIO_REFERENCE_ID=

# --- Rotation tuning (PRD section 9.3) ---
COOLDOWN_PER_MINUTE_MS=60000
POOL_FLUSH_INTERVAL_MS=5000
